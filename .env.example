# Infra
DATABASE_URL=postgres://postgres:postgres@localhost:5433/deriv_intel
REDIS_URL=redis://localhost:6379

# LLM (OpenAI-compatible: base URL + model via env, provider can be swapped freely)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# USD per 1M tokens "model:input:output,..." used for cost estimation
LLM_PRICES=gpt-4o-mini:0.15:0.60,gpt-4o:2.50:10.00

# Reddit API (https://www.reddit.com/prefs/apps, "script" type app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=deriv-intelligence/0.1 by u/research_bot
REDDIT_QUERIES=Deriv broker,Deriv withdrawal,Deriv deposit,Deriv KYC,deriv.app,Deriv review,Deriv MT5,Deriv Bot,DTrader,Binary.com,Deriv scam,Deriv wd,Deriv penarikan,Deriv no gree pay,Exness vs Deriv,IQ Option vs Deriv,Exness withdrawal,IQ Option withdrawal
REDDIT_SUBREDDITS=Forex,Daytrading,binaryoptions,Forex_Trading_Fund,algotrading

# YouTube Data API v3 (10,000 units/day quota)
YOUTUBE_API_KEY=
YOUTUBE_QUERIES=Deriv broker review,Deriv withdrawal,Deriv trading tutorial,Deriv MT5,Deriv Bot,Deriv app review,Deriv penipu,Exness review,IQ Option withdrawal,OctaFX review
YOUTUBE_DAILY_QUOTA=9500

# Google Play reviews (via scraper, free, per country)
GPLAY_APP_ID=com.deriv.app
GPLAY_COUNTRIES=us,gb,ng,id,in,br,za,my,ph,ke,pk,bd,vn,th
GPLAY_REVIEWS_PER_COUNTRY=150
# optional per-country language override "country:lang,..." (defaults: id:id, br:pt, vn:vi, th:th, my:ms, pk:ur, bd:bn)
GPLAY_LANGS=

# Tavily web search (free tier ~1000 credits/month)
TAVILY_API_KEY=
TAVILY_QUERIES=Deriv broker review,Deriv withdrawal issues,Deriv CTOT,Deriv MT5,Deriv Bot,Deriv no gree pay,Exness broker review,IQ Option withdrawal issues

# Brand benchmark (Phase 2): lowercase brand tags used by the classifier
TRACKED_BRANDS=deriv,exness,iq option,octafx

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitored brand
TARGET_BRAND=Deriv
